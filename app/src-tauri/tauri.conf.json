{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Efinity FaceCam",
  "version": "0.1.0",
  "identifier": "com.themis.facecam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:all"
  },
  "app": {
    "windows": [
      {
        "title": "Efinity FaceCam",
        "width": 1150,
        "height": 920,
        "minWidth": 950,
        "minHeight": 750,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/FaceCam_Backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
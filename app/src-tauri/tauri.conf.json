{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FaceCam",
  "version": "0.3.0",
  "identifier": "com.themis.facecam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node clean_builds.js && npm run build",
    "beforeBundleCommand": "node post_build.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Efinity FaceCam",
        "width": 1150,
        "height": 920,
        "minWidth": 950,
        "minHeight": 750,
        "center": true,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#0a0e1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "THEMIS",
    "homepage": "https://ecube.gg/",
    "shortDescription": "Ensure Event Excellence",
    "longDescription": "Ensure Event Excellence",
    "copyright": "© 2026 THEMIS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Efinity FaceCam Lan",
  "version": "2.0.0",
  "identifier": "com.themis.facecamlan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node clean_builds.js && npm run build",
    "beforeBundleCommand": "node post_build.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Efinity FaceCam Lan",
        "width": 1150,
        "height": 920,
        "minWidth": 950,
        "minHeight": 750,
        "center": true,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#0a0e1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["models/", "DirectML.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Free Fire esports stats and match data tool",
    "longDescription": "Efinity FireStats is a desktop application for fetching and analyzing Free Fire esports match data, weapon progression, and player statistics.",
    "publisher": "THEMIS",
    "category": "Utility",
    "copyright": "Copyright © 2026 THEMIS"
  }
}

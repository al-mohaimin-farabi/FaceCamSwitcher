{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FaceCam Observer",
  "version": "0.2.0",
  "identifier": "com.themis.facecam.observer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FaceCam Observer",
        "width": 720,
        "height": 760,
        "minWidth": 560,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0a0e1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
